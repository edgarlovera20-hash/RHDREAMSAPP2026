# Gemini AI keys. Use free for light tasks and paid for agents/audio/heavier flows.
# On Cloudflare, configure these as Worker/Pages Function secrets.
GEMINI_FREE_API_KEY="MY_FREE_GEMINI_API_KEY"
GEMINI_PAID_API_KEY="MY_PAID_GEMINI_API_KEY"
GEMINI_DEFAULT_TIER="free"
GEMINI_TEXT_MODEL="gemini-3.5-flash"
GEMINI_AUDIO_MODEL="gemini-2.5-flash"

# Legacy fallback supported by the backend if only one key is available.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Groq API. OpenAI-compatible endpoint: https://api.groq.com/openai/v1
GROQ_API_KEY="MY_GROQ_API_KEY"
GROQ_MODEL="llama-3.1-8b-instant"

# OpenRouter API. OpenAI-compatible endpoint: https://openrouter.ai/api/v1
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"
OPENROUTER_MODEL="openrouter/auto"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Required if you enable Express JWT-protected routes.
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"
RHDREAMS_ADMIN_USERNAME="admin"
RHDREAMS_ADMIN_EMAIL="admin@example.com"
RHDREAMS_ADMIN_PASSWORD_HASH="BCRYPT_HASH_HERE"
RHDREAMS_ADMIN_NAME="Administrador"
RHDREAMS_ADMIN_ROLE="Admin"
RHDREAMS_WEBHOOK_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"
RHDREAMS_DEFAULT_COMPANY_ID="heavenly-dreams"

# Optional when the frontend calls an API deployed separately from Cloudflare Pages.
VITE_API_BASE_URL="https://api.example.com"

# Indeed Partner API. Requires Indeed Partner Console access.
INDEED_CLIENT_ID="MY_INDEED_CLIENT_ID"
INDEED_CLIENT_SECRET="MY_INDEED_CLIENT_SECRET"
INDEED_EMPLOYER_ID="MY_INDEED_EMPLOYER_ID"
INDEED_WEBHOOK_SECRET="MY_INDEED_WEBHOOK_SECRET"

# Computrabajo authorized import/feed settings.
COMPUTRABAJO_COUNTRY_PORTAL="computrabajo.com.mx"
COMPUTRABAJO_COMPANY_ACCOUNT="MY_COMPANY_ACCOUNT"
COMPUTRABAJO_IMPORT_SECRET="MY_COMPUTRABAJO_IMPORT_SECRET"

# WhatsApp Baileys local connector. Baileys links a WhatsApp Web device by QR.
BAILEYS_SESSION_ID="default"
BAILEYS_LOG_LEVEL="silent"
BAILEYS_MAX_SESSION_MESSAGES="1000"

# Persistent AI message queue. Use Redis + BullMQ in production so pending
# messages survive app restarts and workers can retry transient failures.
REDIS_URL="redis://127.0.0.1:6379"
AI_QUEUE_DRIVER="redis"
AI_QUEUE_NAME="rhdreams-agent-replies"
AI_QUEUE_CONCURRENCY="4"
AI_QUEUE_MAX_SIZE="500"
AI_QUEUE_ATTEMPTS="3"
AI_QUEUE_BACKOFF_MS="10000"
AI_QUEUE_WAIT_TIMEOUT_MS="30000"
API_RATE_LIMIT_MAX="300"
GEMINI_RATE_LIMIT_MAX="75"

# Meta Marketing API / Facebook Recruitment Ads reporting.
META_PAGE_ID=816119458245096
META_PAGE_ACCESS_TOKEN=EAAY8HzGvR08BRiyaCzaKKWNTthAgZAmsGHkJQIj5tv8ZAI6hshz30ZByrO2F4xJhDPZCnZCUvjMFwdElvuCTFVAY7ZCSbUk1zoOd66ELcYqr2jZA6FAgVpfapNtV8QUZAtJpOKkJVLpovBxhiMoKAbvz1QgJFZCD1Ayg0NzZBN4reP5qOxftxPLWGEpbxj0GZCqcnx89uRgt8EZBVqSYZAxw0EaObswbEsLzLGbi0ZBd28RG4ZD
