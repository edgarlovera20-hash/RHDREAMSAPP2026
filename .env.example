# Gemini AI keys. Use free for light tasks and paid for agents/audio/heavier flows.
# On Cloudflare, configure these as Worker/Pages Function secrets.
GEMINI_FREE_API_KEY="MY_FREE_GEMINI_API_KEY"
GEMINI_PAID_API_KEY="MY_PAID_GEMINI_API_KEY"
GEMINI_DEFAULT_TIER="free"
GEMINI_TEXT_MODEL="gemini-3.5-flash"
GEMINI_AUDIO_MODEL="gemini-2.5-flash"

# Legacy fallback supported by the backend if only one key is available.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Groq API. OpenAI-compatible endpoint: https://api.groq.com/openai/v1
GROQ_API_KEY="MY_GROQ_API_KEY"
GROQ_MODEL="llama-3.1-8b-instant"

# OpenRouter API. OpenAI-compatible endpoint: https://openrouter.ai/api/v1
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"
OPENROUTER_MODEL="openrouter/auto"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional when the frontend calls an API deployed separately from Cloudflare Pages.
VITE_API_BASE_URL="https://api.example.com"

# Indeed Partner API. Requires Indeed Partner Console access.
INDEED_CLIENT_ID="MY_INDEED_CLIENT_ID"
INDEED_CLIENT_SECRET="MY_INDEED_CLIENT_SECRET"
INDEED_EMPLOYER_ID="MY_INDEED_EMPLOYER_ID"
INDEED_WEBHOOK_SECRET="MY_INDEED_WEBHOOK_SECRET"

# Computrabajo authorized import/feed settings.
COMPUTRABAJO_COUNTRY_PORTAL="computrabajo.com.mx"
COMPUTRABAJO_COMPANY_ACCOUNT="MY_COMPANY_ACCOUNT"
COMPUTRABAJO_IMPORT_SECRET="MY_COMPUTRABAJO_IMPORT_SECRET"

# WhatsApp Baileys local connector. Baileys links a WhatsApp Web device by QR.
BAILEYS_SESSION_ID="default"
BAILEYS_LOG_LEVEL="silent"

# Meta Marketing API / Facebook Recruitment Ads reporting.
META_GRAPH_VERSION="v24.0"
META_ADS_ACCESS_TOKEN="MY_META_MARKETING_ACCESS_TOKEN"
META_AD_ACCOUNT_ID="act_000000000000000"
META_ADS_PAGE_ID="MY_FACEBOOK_PAGE_ID"

# Canva Connect API.
# Basic creative creation requires design:content:write.
# Brand Template Autofill requires Canva Enterprise and template scopes.
CANVA_ACCESS_TOKEN="MY_CANVA_ACCESS_TOKEN"
