# PostgreSQL connection string for Prisma.
DATABASE_URL="postgresql://user:password@localhost:5432/hdrh"

# Gemini AI keys. Use free for light tasks and paid for agents/audio/heavier flows.
# On Cloudflare, configure these as Worker/Pages Function secrets.
GEMINI_FREE_API_KEY="MY_FREE_GEMINI_API_KEY"
GEMINI_PAID_API_KEY="MY_PAID_GEMINI_API_KEY"
GEMINI_DEFAULT_TIER="free"
GEMINI_TEXT_MODEL="gemini-2.0-flash"
GEMINI_AUDIO_MODEL="gemini-2.5-flash"

# Legacy fallback supported by the backend if only one key is available.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Groq API. OpenAI-compatible endpoint: https://api.groq.com/openai/v1
GROQ_API_KEY="MY_GROQ_API_KEY"
GROQ_MODEL="llama-3.1-8b-instant"

# OpenRouter API. OpenAI-compatible endpoint: https://openrouter.ai/api/v1
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"
OPENROUTER_MODEL="openrouter/auto"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Required if you enable Express JWT-protected routes.
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"
RHDREAMS_ADMIN_USERNAME="admin"
RHDREAMS_ADMIN_EMAIL="admin@example.com"
RHDREAMS_ADMIN_PASSWORD_HASH="BCRYPT_HASH_HERE"
RHDREAMS_ADMIN_NAME="Administrador"
RHDREAMS_ADMIN_ROLE="Admin"
RHDREAMS_WEBHOOK_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"
RHDREAMS_DEFAULT_COMPANY_ID="heavenly-dreams"

# n8n webhook shared secret. Must match the x-n8n-secret header sent by n8n.
N8N_WEBHOOK_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"

# Cross-platform event forwarding (producers send to subscriber ingest endpoints)
EVENT_BUS_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"
BRAIN_EVENTS_URL="http://localhost:3003/api/events/ingest"
OPERATIONS_EVENTS_URL="http://localhost:3005/api/events/ingest"

# Optional when the frontend calls an API deployed separately from Cloudflare Pages.
VITE_API_BASE_URL="https://api.example.com"

# Set to "true" ONLY in local development to load demo chat conversations.
VITE_ENABLE_DEMO_DATA="false"

# Indeed Partner API. Requires Indeed Partner Console access.
INDEED_CLIENT_ID="MY_INDEED_CLIENT_ID"
INDEED_CLIENT_SECRET="MY_INDEED_CLIENT_SECRET"
INDEED_EMPLOYER_ID="MY_INDEED_EMPLOYER_ID"
INDEED_WEBHOOK_SECRET="MY_INDEED_WEBHOOK_SECRET"

# Computrabajo authorized import/feed settings.
COMPUTRABAJO_COUNTRY_PORTAL="computrabajo.com.mx"
COMPUTRABAJO_COMPANY_ACCOUNT="MY_COMPANY_ACCOUNT"
COMPUTRABAJO_IMPORT_SECRET="MY_COMPUTRABAJO_IMPORT_SECRET"

# WhatsApp Baileys local connector.
BAILEYS_SESSION_ID="default"
BAILEYS_LOG_LEVEL="silent"
BAILEYS_MAX_SESSION_MESSAGES="1000"

# WhatsApp Meta Cloud API official connector.
META_WEBHOOK_VERIFY_TOKEN="MY_META_WEBHOOK_VERIFY_TOKEN"
META_APP_SECRET="MY_META_APP_SECRET"
WHATSAPP_APP_SECRET="MY_OPTIONAL_WHATSAPP_APP_SECRET"
WHATSAPP_CLOUD_ACCESS_TOKEN="MY_WHATSAPP_CLOUD_ACCESS_TOKEN"
WHATSAPP_PHONE_NUMBER_ID="MY_WHATSAPP_PHONE_NUMBER_ID"
WHATSAPP_BUSINESS_ACCOUNT_ID="MY_WHATSAPP_BUSINESS_ACCOUNT_ID"
WHATSAPP_AGENT_NAME="Agente WhatsApp Meta RH"

# Persistent AI message queue.
REDIS_URL="redis://127.0.0.1:6379"
AI_QUEUE_DRIVER="redis"
AI_QUEUE_NAME="rhdreams-agent-replies"
AI_QUEUE_CONCURRENCY="4"
AI_QUEUE_MAX_SIZE="500"
AI_QUEUE_ATTEMPTS="3"
AI_QUEUE_BACKOFF_MS="10000"
AI_QUEUE_WAIT_TIMEOUT_MS="30000"
API_RATE_LIMIT_MAX="300"
GEMINI_RATE_LIMIT_MAX="75"

# Meta Marketing API.
META_PAGE_ID="MY_META_PAGE_ID"
META_PAGE_ACCESS_TOKEN="MY_META_PAGE_ACCESS_TOKEN"
META_IG_USER_ID="MY_META_IG_USER_ID"

# Canva Connect API.
CANVA_ACCESS_TOKEN="MY_CANVA_ACCESS_TOKEN"
