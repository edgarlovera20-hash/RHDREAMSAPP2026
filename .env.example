# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV="production"
PORT="3000"

# IMPORTANT: Set to a fixed, long random string. Changing this invalidates all
# active JWT sessions. Generate with: openssl rand -hex 64
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET_OPENSSL_RAND_HEX_64"

# Admin account (only one super-admin; additional users via app UI)
RHDREAMS_ADMIN_USERNAME="admin"
RHDREAMS_ADMIN_EMAIL="admin@example.com"
# Generate hash: node -e "require('bcryptjs').hash('YourPass',12).then(h=>console.log(h))"
RHDREAMS_ADMIN_PASSWORD_HASH="$2b$12$REPLACE_WITH_REAL_BCRYPT_HASH"
RHDREAMS_ADMIN_NAME="Administrador"
RHDREAMS_ADMIN_ROLE="Admin"
RHDREAMS_DEFAULT_COMPANY_ID="heavenly-dreams"
RHDREAMS_WEBHOOK_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"

# Allowed domains that can call this server (comma-separated, no trailing slash).
# Leave empty to allow all origins (single-tenant self-hosted).
ALLOWED_ORIGINS="https://rh.heavenlydreams.com.mx"
RH_ALLOWED_HOSTS="rh.heavenlydreams.com.mx"
ADMIN_APP_URL="https://app.heavenlydreams.com.mx"
MAIN_SITE_URL="https://heavenlydreams.com.mx"

# ─── AI Keys ──────────────────────────────────────────────────────────────────
GEMINI_FREE_API_KEY="MY_FREE_GEMINI_API_KEY"
GEMINI_PAID_API_KEY="MY_PAID_GEMINI_API_KEY"
GEMINI_DEFAULT_TIER="free"
GEMINI_TEXT_MODEL="gemini-2.5-flash"
GEMINI_AUDIO_MODEL="gemini-2.5-flash"

# Legacy fallback if only one key is available
GEMINI_API_KEY="MY_GEMINI_API_KEY"

GROQ_API_KEY="MY_GROQ_API_KEY"
GROQ_MODEL="llama-3.1-8b-instant"

OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"
OPENROUTER_MODEL="openrouter/auto"

# ─── Redis + AI Queue ─────────────────────────────────────────────────────────
# REQUIRED for PM2 cluster mode (rate limiting & BullMQ queue are shared via Redis)
REDIS_URL="redis://127.0.0.1:6379"
AI_QUEUE_DRIVER="redis"
AI_QUEUE_NAME="rhdreams-agent-replies"
AI_QUEUE_CONCURRENCY="4"
AI_QUEUE_MAX_SIZE="500"
AI_QUEUE_ATTEMPTS="3"
AI_QUEUE_BACKOFF_MS="10000"
AI_QUEUE_WAIT_TIMEOUT_MS="30000"

# ─── Rate Limits ──────────────────────────────────────────────────────────────
API_RATE_LIMIT_MAX="300"
GEMINI_RATE_LIMIT_MAX="75"

# ─── WhatsApp Baileys (QR-based) ──────────────────────────────────────────────
BAILEYS_SESSION_ID="default"
BAILEYS_LOG_LEVEL="silent"
BAILEYS_MAX_SESSION_MESSAGES="1000"
# Increase for production (default 5 is very low). Set to 20-50 based on server RAM.
BAILEYS_MAX_SESSIONS="20"

# ─── WhatsApp Meta Cloud API ──────────────────────────────────────────────────
META_WEBHOOK_VERIFY_TOKEN="MY_META_WEBHOOK_VERIFY_TOKEN"
META_APP_SECRET="MY_META_APP_SECRET"
WHATSAPP_APP_SECRET="MY_OPTIONAL_WHATSAPP_APP_SECRET"
WHATSAPP_CLOUD_ACCESS_TOKEN="MY_WHATSAPP_CLOUD_ACCESS_TOKEN"
WHATSAPP_PHONE_NUMBER_ID="MY_WHATSAPP_PHONE_NUMBER_ID"
WHATSAPP_BUSINESS_ACCOUNT_ID="MY_WHATSAPP_BUSINESS_ACCOUNT_ID"
WHATSAPP_AGENT_NAME="Agente WhatsApp Meta RH"

# ─── Google Workspace ─────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID="MY_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="MY_GOOGLE_CLIENT_SECRET"
GOOGLE_REDIRECT_URI="https://rh.heavenlydreams.com.mx/api/google/callback"

# ─── Job Boards ───────────────────────────────────────────────────────────────
INDEED_CLIENT_ID="MY_INDEED_CLIENT_ID"
INDEED_CLIENT_SECRET="MY_INDEED_CLIENT_SECRET"
INDEED_EMPLOYER_ID="MY_INDEED_EMPLOYER_ID"
INDEED_WEBHOOK_SECRET="MY_INDEED_WEBHOOK_SECRET"

COMPUTRABAJO_COUNTRY_PORTAL="computrabajo.com.mx"
COMPUTRABAJO_COMPANY_ACCOUNT="MY_COMPANY_ACCOUNT"
COMPUTRABAJO_IMPORT_SECRET="MY_COMPUTRABAJO_IMPORT_SECRET"

# ─── Social / Marketing ───────────────────────────────────────────────────────
META_PAGE_ID="MY_META_PAGE_ID"
META_PAGE_ACCESS_TOKEN="MY_META_PAGE_ACCESS_TOKEN"
META_IG_USER_ID="MY_META_IG_USER_ID"

CANVA_ACCESS_TOKEN="MY_CANVA_ACCESS_TOKEN"

# ─── App URL ──────────────────────────────────────────────────────────────────
APP_URL="https://rh.heavenlydreams.com.mx"
VITE_API_BASE_URL=""
